# Copy to .env and fill in real values. Never commit .env.
# On Vercel these are set as project environment variables instead.

OPENAI_API_KEY=sk-proj-REPLACE_ME

SUPABASE_URL=https://REPLACE_ME.supabase.co

# Must be the SECRET key (sb_secret_...), never the publishable one.
# RLS is deny-by-default, so the publishable key reads zero rows and every
# lookup fails silently. config.py also accepts SUPABASE_SERVICE_KEY,
# SUPABASE_SERVICE_ROLE_KEY, or SUPABASE_KEY as aliases.
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
